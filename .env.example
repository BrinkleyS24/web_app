## Backend
# IMPORTANT: Vite loads .env.local in every mode, including production builds.
# Put local-only development overrides in .env.development.local instead.
# Local backend:
VITE_API_BASE_URL=http://localhost:3000
#
# Cloud Run backend:
# VITE_API_BASE_URL=https://YOUR_BACKEND_URL

## Firebase (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

## Dev-only local auth bypass
# Frontend bypass only controls the local shell. Backend admin access remains server-enforced.
VITE_DEV_AUTH_BYPASS=false
VITE_DEV_AUTH_EMAIL=dev@example.test
VITE_DEV_AUTH_ADMIN=false
VITE_DEV_AUTH_UID=local-dev-user

## Public site
VITE_CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/applendium/aaalkagnioipinkfogjlgkdoacebaoji?hl=en&authuser=0
VITE_CHROME_WEB_STORE_STATE=live
VITE_WEB_WORKSPACE_IS_PUBLIC=false
VITE_APPLY_GATE_DISPLAY_DECISION_V1=false
